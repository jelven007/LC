# 统一按 LF 存储，Windows 检出时自动转换，避免跨平台换行符噪音
* text=auto

# 源码与文本文件：强制 LF
*.js      text eol=lf
*.json    text eol=lf
*.wxml    text eol=lf
*.wxss    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制文件：不做任何转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
